{
  "name": "codemirror-lang-groovy",
  "version": "0.1.0",
  "description": "Groovy language support for CodeMirror 6, built on a Lezer grammar",
  "keywords": [
    "codemirror",
    "lezer",
    "groovy",
    "editor",
    "syntax-highlighting"
  ],
  "author": "Scott Murphy Heiberg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeconsole/codemirror-lang-groovy.git"
  },
  "homepage": "https://github.com/codeconsole/codemirror-lang-groovy#readme",
  "bugs": "https://github.com/codeconsole/codemirror-lang-groovy/issues",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "lezer-generator src/groovy.grammar -o src/parser.js && rollup -c && node scripts/copy-types.js",
    "build-debug": "lezer-generator src/groovy.grammar --names -o src/parser.js && rollup -c && node scripts/copy-types.js",
    "prepare": "npm run build",
    "test": "mocha test/test-*.js",
    "corpus": "node scripts/corpus.js"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/generator": "^1.8.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "mocha": "^12.0.3",
    "rollup": "^4.68.0"
  }
}
